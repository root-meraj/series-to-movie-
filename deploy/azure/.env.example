# Account demo: the private operator key can see and control every job.
# Copy to .env on the Azure Linux VM. Do not place this file in the frontend.
# On Linux the private file must be readable by UID 10001; see README.md.

# Bare hostname only, without https://, port or path. An Azure public-IP DNS label
# can supply a free hostname such as sts-demo.centralindia.cloudapp.azure.com.
STS_BACKEND_DOMAIN=
# Your exact deployed frontend origin, without a path or trailing slash.
# Current Vercel website; add a custom domain only when it is actually deployed.
STS_WEB_ALLOWED_ORIGINS=https://series-to-movie-854n.vercel.app
# Generate at least 32 random non-whitespace characters. Leave no sample secret.
STS_WEB_ACCESS_TOKEN=

# Compose sets these for the private backend and generates its public HTTPS URL.
STS_WEB_HOST=0.0.0.0
STS_WEB_PORT=8765
STS_WEB_JOBS_DIR=/app/data/jobs
# Sixteen GiB per ZIP; uploads spool to persistent disk, not RAM.
STS_WEB_MAX_UPLOAD_BYTES=17179869184
STS_WEB_ACCOUNTS_ENABLED=true
# Bound initial registration while the single-server pilot is being tested.
STS_WEB_MAX_ACCOUNTS=100
# Per-request proxy ceiling includes one MiB of multipart overhead.
STS_PROXY_MAX_REQUEST_BYTES=17180917760

# Start with the small model already used in the local project. This does not
# guarantee scene-selection quality or processing speed on a two-core CPU VM.
# Pull the identical model into the Ollama service before starting an edit.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://ollama:11434
ENABLE_OPENAI=false
OPENAI_API_KEY=

TRANSCRIPT_SOURCE=auto
SUBTITLE_LANGUAGE=en
SCENE_METHOD=subtitles
SCENE_BLOCK_SECONDS=60
EXCLUDE_CREDITS=true
SELECTION_STRATEGY=story
LLM_BATCH_SIZE=8
TARGET_MINUTES=120
MIN_CLIP_SECONDS=15
MIN_SCENE_SECONDS=5
DETECTOR_THRESHOLD=27
SEASON_NUMBER=1
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
RENDER_ENCODER=libx264
SBERT_MODEL=all-MiniLM-L6-v2
SCORE_WEIGHTS=0.5,0.3,0.1,0.1
MAX_CHARACTERS=12
