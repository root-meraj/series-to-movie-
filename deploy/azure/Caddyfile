{
	admin off
	# Request URLs can contain export tickets, including on failed proxy requests.
	# Keep certificate/startup diagnostics without recording HTTP request logs.
	log default {
		exclude http.log.access http.log.error
	}
	servers {
		timeouts {
			read_header 30s
			# No total deadline for large uploads/downloads over a phone connection.
			read_body 0
			write 0
		}
	}
}

{$STS_BACKEND_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# Match the configured API ZIP ceiling with room for multipart overhead.
	request_body {
		max_size {$STS_PROXY_MAX_REQUEST_BYTES:2148532224}
	}
	# No site `log` directive: access logging stays disabled.
	# Forward paths, authorization, CORS preflights and Range headers unchanged.
	reverse_proxy backend:8765 {
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 0
			read_timeout 0
			write_timeout 0
		}
	}
}
