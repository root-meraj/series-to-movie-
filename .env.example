WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto
TRANSCRIPT_SOURCE=auto
SUBTITLE_LANGUAGE=en
DETECTOR_THRESHOLD=27.0
MIN_SCENE_SECONDS=5.0
SCENE_METHOD=subtitles
SCENE_BLOCK_SECONDS=60
EXCLUDE_CREDITS=true
SELECTION_STRATEGY=story
LLM_BATCH_SIZE=8
RENDER_ENCODER=auto
TARGET_MINUTES=120
MIN_CLIP_SECONDS=15.0
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Explicit opt-in before any OpenAI requests. Use LLM_PROVIDER=mock for offline checks.
ENABLE_OPENAI=false
SEASON_NUMBER=1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
SBERT_MODEL=all-MiniLM-L6-v2
# llm, textrank, audio_rms, dialogue_ratio
SCORE_WEIGHTS=0.5,0.3,0.1,0.1
MAX_CHARACTERS=12

# Optional persistent web API (static Vercel frontend lives in web/).
# Set a private random token of at least 32 characters before starting the API.
# Never put this token in web/config.js or commit your .env.
STS_WEB_ACCESS_TOKEN=
STS_WEB_ALLOWED_ORIGINS=http://127.0.0.1:3000
STS_WEB_JOBS_DIR=data/jobs
STS_WEB_HOST=127.0.0.1
STS_WEB_PORT=8765
# Production HTTPS backend origin, e.g. https://processor.example.com
STS_WEB_PUBLIC_URL=
